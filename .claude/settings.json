{
  "permissions": {
    "allow": [
      "WebFetch(domain:pypi.org)",
      "Bash(python claude_test/test_piper_joint_read.py --can can0 --duration 3)",
      "Read(//usr/bin/**)",
      "Bash(/workspace/FR5ControllerVLA/.venv/bin/python --version)",
      "Bash(ip link:*)",
      "Bash(python claude_test/test_fr5_keyboard_sim.py)",
      "Bash(/opt/conda/envs/lerobot/bin/python claude_test/test_fr5_keyboard_sim.py)",
      "Bash(/opt/conda/envs/lerobot/bin/python -c \"from lerobot.robots.fairino.fairino_follower import FairinoFollower; print\\('import OK'\\)\")",
      "Bash(/opt/conda/envs/lerobot/bin/ruff check:*)",
      "Bash(ls -la /workspace/FR5ControllerVLA/src/lerobot/robots/fairino/*.py)",
      "Bash(grep -l \"gripper\\\\|Gripper\\\\|MoveGripper\\\\|ActGripper\" /workspace/FR5ControllerVLA/src/lerobot/robots/fairino/fairino/example/*.py)",
      "Bash(/opt/conda/envs/lerobot/bin/python claude_test/test_fr5_gripper.py)",
      "Bash(/opt/conda/envs/lerobot/bin/python claude_test/test_fr5_keyboard_10s.py)",
      "Bash(timeout 10 /opt/conda/envs/lerobot/bin/python -c ':*)",
      "Bash(/opt/conda/envs/lerobot/bin/python claude_test/test_fr5_leader_follower.py)",
      "Bash(/opt/conda/envs/lerobot/bin/python -c ':*)",
      "Bash(git status:*)",
      "Bash(git add:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-write-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-write-lint.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-write-debug-remind.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Before stopping, verify: 1) If any task was performed, does ToDo.md have a corresponding entry? 2) Was a GitHub issue created via gh? 3) If Python files were modified, did ruff checks pass? 4) If files were added to claude_test/, was claude_test/README.md updated? If any check fails, block and explain what is missing.",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
